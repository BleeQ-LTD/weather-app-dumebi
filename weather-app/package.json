{
  "name": "weather-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "server": "tsx server/index.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check-weather": "node scripts/check-weather.mjs",
    "preview": "vite preview",
    "test": "npx firebase-tools emulators:exec --only firestore --project demo-weather-rules \"npx vitest run\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-weather-rules \"vitest run rules-tests/firebase.rules.test.ts\"",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^5.3.0",
    "firebase": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
